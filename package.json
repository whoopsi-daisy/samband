{
  "name": "sambandscentralen",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build && npm run postbuild:clean",
    "postbuild:clean": "node -e \"require('fs').rmSync('.next/standalone/data',{recursive:true,force:true})\"",
