# Copy to .env next to docker-compose.yml and edit. Every value here has a
# working default, so an empty .env still starts.

# --- Image ----------------------------------------------------------------
# Which published image to run. `latest` follows the newest release, `edge`
# follows main, or pin a release (e.g. 1.2.0) for a deployment that cannot
# move under you.
SAMBAND_TAG=latest
# Only if you publish the image from a fork.
#SAMBAND_REPO=whoopsi-daisy/samband

# --- Networking -----------------------------------------------------------
# Host port to publish the app on.
SAMBAND_PORT=3000
# Number of reverse proxies in front of the app. The client IP used for rate
# limiting is read this many entries from the right of X-Forwarded-For.
RATE_LIMIT_PROXY_HOPS=1

# --- Access ---------------------------------------------------------------
# HTTP Basic auth for /stats and the import API. /stats shows fetch logs,
# error history and database internals; the import API can start or cancel a
# multi-hour job. With both left empty these routes answer 503 rather than
# opening to anyone who finds the URL — set them to use the dashboard.
STATS_USER=
STATS_PASSWORD=
# Only if you actively want /stats reachable without a login.
#STATS_PUBLIC=true

# --- Import ---------------------------------------------------------------
# What to do on startup, if anything:
#   ndjson      - load BPK_IMPORT_SOURCE once, then keep it current
#   full        - walk the whole API archive (hours), then keep it current
#   incremental - only pull what is new since the last run
# Leave empty to import nothing on boot and start runs from /stats instead.
BPK_IMPORT_ON_START=
# The dump to load. A bare name is read from the data directory, so a file at
# ./data/brottsplatskartan.ndjson is named here as brottsplatskartan.ndjson.
# An http(s) URL is also accepted.
BPK_IMPORT_SOURCE=brottsplatskartan.ndjson
# Parallel requests when walking the API. 4 is deliberately gentle on a free
# hobby API; 8 is the ceiling.
BPK_IMPORT_CONCURRENCY=4

# How the archive's search index tokenises text.
#   trigram   - matches substrings, so "guldsmed" finds "guldsmedsaffär".
#               ~350 MB of index for a full 333k-event archive (default)
#   unicode61 - matches whole words and prefixes only, ~55 MB
# Changing this rebuilds the index on the next start (~20 s per 333k events).
#BPK_SEARCH_TOKENIZER=trigram

# --- VMA ------------------------------------------------------------------
# Where the VMA page reads emergency warnings from. The default is Sveriges
# Radio's live v3 API and needs no key. Setting it to
# https://vmaapi.sr.se/testapi/v3 reads SR's test feed instead, which is how to
# see the page with warnings in it without waiting for a real emergency.
# Only the live default carries real warnings. Never point a deployment the
# public reads at the test base.
#VMA_API_BASE=https://vmaapi.sr.se/api/v3

# --- Do not change --------------------------------------------------------
# The app parses Swedish wall-clock times out of event text and renders them
# back. Anything but Europe/Stockholm shifts every event by 1-2 hours.
TZ=Europe/Stockholm
